#
# Copy to .env and fill in values.
#

# LiteLLM proxy auth (matches general_settings.master_key)
LITELLM_MASTER_KEY=sk-llm-proxy-local

# Optional convenience vars for Claude-compatible clients
ANTHROPIC_BASE_URL=http://127.0.0.1:4010
ANTHROPIC_API_KEY=sk-llm-proxy-local

# OpenRouter API key (used by all models in config.all.yaml)
OPENROUTER_API_KEY=

# NVIDIA NIM keys (per model alias)
NVIDIA_NIM_API_KEY_PRODUCT_ARCHITECT=
NVIDIA_NIM_API_KEY_BACKEND=
NVIDIA_NIM_API_KEY_IOS=
NVIDIA_NIM_API_KEY_ANDROID=
NVIDIA_NIM_API_KEY_QA=

